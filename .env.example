# Optioneel: kopieer naar .env om lokale standaardwaarden te wijzigen.
# Alleen voor development; dit zijn geen productiecredentials.
POSTGRES_DB=samplecheck
POSTGRES_USER=samplecheck
POSTGRES_PASSWORD=samplecheck_dev
POSTGRES_PORT=5432
REDIS_PORT=6379

# Optionele override voor migrations/seed; anders worden bovenstaande waarden gebruikt.
# Vanuit een app-container is de host postgres, niet localhost.
# DATABASE_URL=postgresql://samplecheck:samplecheck_dev@localhost:5432/samplecheck

# Optioneel: aparte gemigreerde PostgreSQL-database voor integratietests.
# TEST_DATABASE_URL=postgresql://samplecheck:samplecheck_dev@localhost:5432/samplecheck_test
